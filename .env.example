# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both values are public by design (they end up in the browser). The database rules in
# supabase/migrations/001_init.sql decide what they can do.
# NEVER put the secret key / service_role key, the database password or the Google client secret here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
